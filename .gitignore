# ============================================================
# AI Personalized Learning Recommendation System
# Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
dist/
build/
.vite/
*.local

# -------------------------
# IDE
# -------------------------
.vscode/
.idea/

# -------------------------
# OS
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Logs
# -------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# -------------------------
# Raw datasets
# -------------------------
data/raw/

# -------------------------
# Generated processed datasets
# -------------------------
data/processed/*.csv

# Keep only documentation/reproducible evaluation assets
!data/processed/evaluation_plots/
!data/processed/evaluation_plots/*.png

# -------------------------
# Temporary / local scripts
# -------------------------
check_profile.py
test_authenticated.py
project_structure.txt

# -------------------------
# Temporary CSS backup
# -------------------------
frontend-app/src/index_final_layout_v2.css

# -------------------------
# Python-generated temporary files
# -------------------------
*.tmp
*.bak

# Temporary experiment output
temp_step*.txt
